{
  "name": "BoardItem",
  "type": "object",
  "properties": {
    "board_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 180
    },
    "description": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "TO_DO",
        "IN_PROGRESS",
        "DONE"
      ],
      "default": "TO_DO"
    },
    "order_index": {
      "type": "integer",
      "default": 0
    },
    "assigned_to": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "default": "MEDIUM"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "board_id",
    "title"
  ]
}