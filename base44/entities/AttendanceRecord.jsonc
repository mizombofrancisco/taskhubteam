{
  "name": "AttendanceRecord",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "check_in": {
      "type": "string",
      "maxLength": 8
    },
    "lunch_out": {
      "type": "string",
      "maxLength": 8
    },
    "lunch_in": {
      "type": "string",
      "maxLength": 8
    },
    "check_out": {
      "type": "string",
      "maxLength": 8
    },
    "total_hours": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "PRESENT",
        "ABSENT",
        "LATE",
        "HALF_DAY",
        "REMOTE",
        "HOLIDAY",
        "MISSING"
      ],
      "default": "PRESENT"
    },
    "notes": {
      "type": "string",
      "maxLength": 255
    }
  },
  "required": [
    "user_id",
    "date",
    "status"
  ]
}