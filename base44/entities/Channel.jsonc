{
  "name": "Channel",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "maxLength": 80
    },
    "slug": {
      "type": "string",
      "maxLength": 80
    },
    "topic": {
      "type": "string",
      "maxLength": 200
    },
    "type": {
      "type": "string",
      "enum": [
        "PROJECT",
        "GENERAL",
        "ANNOUNCEMENTS"
      ],
      "default": "PROJECT"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "is_read_only": {
      "type": "boolean",
      "default": false
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "slug"
  ]
}