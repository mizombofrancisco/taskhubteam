{
  "name": "DirectMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "receiver_id": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "maxLength": 4000
    },
    "attachment_url": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "conversation_id",
    "sender_id",
    "receiver_id",
    "content"
  ]
}